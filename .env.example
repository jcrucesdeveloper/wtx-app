VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_PUBLIC_URL=https://wtxworkout.com
VITE_LEGAL_NAME=
VITE_SUPPORT_EMAIL=
# Ads per app: true turns them on, anything else leaves that app ad-free.
VITE_ADS_ANDROID=false
VITE_ADS_IOS=false
# AdMob (Android). The App ID (with "~") is read by android/app/build.gradle;
# the interstitial unit ID (with "/") by the app. Both from the same AdMob app,
# or no ad ever loads.
ADMOB_APP_ID_ANDROID=
VITE_ADMOB_INTERSTITIAL_ID_ANDROID=
