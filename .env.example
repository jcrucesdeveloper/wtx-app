# Feature flag for ads. Off unless set to `true`: the Mobile Ads SDK is never
# initialised, so there's no consent form, no iOS tracking prompt and no ad
# request, and everything AdMob-related below is ignored.
VITE_ADS_ENABLED=

# Real AdMob ad unit IDs (from the AdMob console). Optional — omit any of
# these and the app falls back to Google's public test ad units, so dev/local
# builds never risk serving real ads. Only set these for a production build,
# typically via a .env.production.local file (gitignored by the `*.local`
# rule) or CI secrets.
#
# Note: this only covers the JS-side *ad unit* IDs. The native AdMob *App*
# IDs aren't Vite env vars — they're native build settings (both default to
# Google's sample App IDs):
#   - Android: Gradle property `admobAppId` (e.g. in ~/.gradle/gradle.properties
#     or `./gradlew bundleRelease -PadmobAppId=ca-app-pub-...~...`) or the
#     ADMOB_APP_ID_ANDROID environment variable. See android/app/build.gradle.
#   - iOS: the `ADMOB_APP_ID` build setting of the App target (Xcode → App →
#     Build Settings, or `xcodebuild ... ADMOB_APP_ID=ca-app-pub-...~...`).
VITE_ADMOB_INTERSTITIAL_ID_ANDROID=
VITE_ADMOB_INTERSTITIAL_ID_IOS=

# AdMob test mode. Leave unset (or anything but `false`) and every ad request
# uses Google's test ad unit, even with real IDs above. Set to `false` ONLY for
# the store build, together with running `ADMOB_TESTING=false npx cap sync`
# (a plain shell env var read by capacitor.config.ts, not a Vite one).
VITE_ADMOB_TESTING=

# Supabase project (Project Settings → API). Only needed for accounts, sync and
# group workouts — the app runs fully local-first without them. The anon key is
# safe to ship: every table is protected by row level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public web address of the app (scheme + host, no path), e.g. https://wtx.app.
# Share links, QR codes and auth emails (sign-up confirmation, password reset)
# point here, and it's the host the native apps claim for deep links. Optional
# on the web (falls back to the current origin), but REQUIRED for store builds:
# inside the native apps the fallback is a localhost URL nobody else can open.
VITE_PUBLIC_URL=

# Sentry DSN (sentry.io → Settings → Client Keys), for crash reporting.
# Optional — omit it and crash reporting simply doesn't start.
VITE_SENTRY_DSN=

# Legal pages: who publishes WTX (the data controller) and a public contact
# email, interpolated into the Terms and Privacy Policy — both in the app and
# in public/privacy.html / public/terms.html (`pnpm build:legal`, also run by
# `pnpm build`). Required for a store release: stores and Chile's Ley 21.719
# need a real name and contact. Unset, the texts point to the store listing.
VITE_SUPPORT_EMAIL=
VITE_LEGAL_NAME=

# Store listings, for the "get the app" banner the web build shows on phones.
# Leave them unset until the listing is live: the banner stays hidden for that
# platform. VITE_APP_STORE_ID is the number in the App Store URL (id123456789);
# VITE_APP_STORE_PROVIDER_ID is optional (App Store Connect -> Analytics ->
# campaign link generator shows it as `pt`) and makes banner taps show up there
# per source. VITE_PLAY_STORE_ID is the package name (com.wtx.app).
VITE_APP_STORE_ID=
VITE_APP_STORE_PROVIDER_ID=
VITE_PLAY_STORE_ID=
