# Real AdMob ad unit IDs (from the AdMob console). Optional — omit any of
# these and the app falls back to Google's public test ad units, so dev/local
# builds never risk serving real ads. Only set these for a production build,
# typically via a .env.production.local file (gitignored by the `*.local`
# rule) or CI secrets.
#
# Note: this only covers the JS-side *ad unit* IDs. The native AdMob *App*
# IDs aren't Vite env vars — they're native build settings (both default to
# Google's sample App IDs):
#   - Android: Gradle property `admobAppId` (e.g. in ~/.gradle/gradle.properties
#     or `./gradlew bundleRelease -PadmobAppId=ca-app-pub-...~...`) or the
#     ADMOB_APP_ID_ANDROID environment variable. See android/app/build.gradle.
#   - iOS: the `ADMOB_APP_ID` build setting of the App target (Xcode → App →
#     Build Settings, or `xcodebuild ... ADMOB_APP_ID=ca-app-pub-...~...`).
VITE_ADMOB_INTERSTITIAL_ID_ANDROID=
VITE_ADMOB_INTERSTITIAL_ID_IOS=

# AdMob test mode. Leave unset (or anything but `false`) and every ad request
# uses Google's test ad unit, even with real IDs above. Set to `false` ONLY for
# the store build, together with running `ADMOB_TESTING=false npx cap sync`
# (a plain shell env var read by capacitor.config.ts, not a Vite one).
VITE_ADMOB_TESTING=

# Supabase project (Project Settings → API). Only needed for accounts, sync and
# group workouts — the app runs fully local-first without them. The anon key is
# safe to ship: every table is protected by row level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry DSN (sentry.io → Settings → Client Keys), for crash reporting.
# Optional — omit it and crash reporting simply doesn't start.
VITE_SENTRY_DSN=
