# Release signing for `./gradlew bundleRelease`. Copy to keystore.properties
# (gitignored) and fill in. Read by app/build.gradle.
#
# storeFile: the upload keystore, absolute or relative to this android/ folder.
# Use forward slashes on Windows (C:/Users/you/keystores/wtx-upload.jks).
storeFile=
storePassword=
keyAlias=wtx-upload
keyPassword=
